[Unit]
Description=PocketBase MBA Laundry
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mba-laundry/pocketbase
EnvironmentFile=/var/www/mba-laundry/.env
ExecStart=/var/www/mba-laundry/pocketbase/pocketbase serve --http=127.0.0.1:8090 --dir=/var/www/mba-laundry/pocketbase/pb_data --migrate
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

