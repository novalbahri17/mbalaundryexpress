# ---------------------------------------------------------------------------
# Frontend (dibaca oleh Vite saat build / dev)
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://mbalaundryexpress.com
VITE_SITE_NAME=MBA Laundry Express
VITE_PUBLIC_PATH=/

# Path API yang dipakai frontend. Biarkan /api.
VITE_API_BASE_PATH=/api

# Alamat API server (Express + MySQL) saat mode dev.
VITE_API_PROXY_TARGET=http://127.0.0.1:3002

# ---------------------------------------------------------------------------
# API server (Express + MySQL) -- jalankan dengan: pnpm api
# ---------------------------------------------------------------------------
# "production" membuat server MENOLAK start kalau API_JWT_SECRET masih kosong
# atau masih nilai contoh. Isi "development" untuk komputer lokal.
NODE_ENV=development

API_PORT=3002

# Akun admin panel. Dibuat otomatis ke tabel _admins saat server pertama kali
# dijalankan. Ganti password ini setelah login pertama.
API_ADMIN_EMAIL=admin@example.com
API_ADMIN_PASSWORD=ganti-password-ini

# WAJIB DIGANTI. Minimal 32 karakter acak, dan beda dari CRON_SECRET.
# Bikin dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_JWT_SECRET=

# Folder penyimpanan file upload (poster promo, galeri, thumbnail blog, dll).
# WAJIB ikut di-backup: file asli gambar ada di sini, bukan di database.
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Database MySQL
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=laundry
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Integrasi opsional
# ---------------------------------------------------------------------------
# Secret untuk script cron (scripts/cron-expire-promos.mjs). WAJIB DIGANTI.
CRON_SECRET=
FONNTE_TOKEN=
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=


